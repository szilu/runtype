{
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "ignoreUnknown": false },

	"formatter": {
		"indentWidth": 4,
		"lineWidth": 100,
		"useEditorconfig": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/lib",
			"!**/*.min.js",
			"!**/pnpm-lock.yaml",
			"!**/*.md"
		]
	},

	"linter": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/lib",
			"!**/*.min.js",
			"!**/*.min.css"
		],
		"rules": {
			"preset": "recommended",

			"suspicious": {
				// Intentional: == null checks used throughout codebase
				"noDoubleEquals": "off",
				// Off: guarded fallthrough in scalar boolean/date coercion is intentional
				"noFallthroughSwitchClause": "off"
			},

			"style": {
				// Intentional: non-null assertions used with validated data
				"noNonNullAssertion": "off",
				// Intentional: string concatenation preferred in some cases
				"useTemplate": "off",
				// Intentional: bare module specifiers used (bundled, not Node.js)
				"useNodejsImportProtocol": "off"
			},

			"complexity": {
				// Off: `{}` is a domain type (T.defined / T.unknownObject)
				"noBannedTypes": "off",
				// Intentional: function expressions preferred in some patterns
				"useArrowFunction": "off"
			}
		}
	},

	"overrides": [
		{
			"includes": ["**/*.spec.ts"],
			"linter": {
				"rules": {
					"correctness": {
						// Spec files declare unused consts/aliases as compile-time
						// type-inference tests
						"noUnusedVariables": "off"
					}
				}
			}
		}
	],

	"javascript": {
		"formatter": {
			"trailingCommas": "none",
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":BUN:", ":NODE:", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:"],
							":BLANK_LINE:",
							[":ALIAS:", ":PATH:"]
						]
					}
				}
			}
		}
	}
}
